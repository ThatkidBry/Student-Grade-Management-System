        var q1 = Number(row.querySelector(".q1").value);
        var q2 = Number(row.querySelector(".q2").value);
        var q3 = Number(row.querySelector(".q3").value);
        var quizSum = q1 + q2 + q3;
        var totalQuizPercentage = (quizSum / 30) * 100;

        // 2. Performance Tasks: Add all 4 PTs first, then divide by 4
        var pt1 = Number(row.querySelector(".pt1").value);
        var pt2 = Number(row.querySelector(".pt2").value);
        var pt3 = Number(row.querySelector(".pt3").value);
        var pt4 = Number(row.querySelector(".pt4").value);
        var ptSum = pt1 + pt2 + pt3 + pt4;
        var ptTotalPercentage = (ptSum / 200) * 100;

